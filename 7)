import math

class Banco:
    def __init__(self, nombre, tasa_interes):
        self.nombre = nombre              
        self.tasa_interes = tasa_interes  

    def obtener_nombre(self):
        return self.nombre

    def establecer_nombre(self, nombre):
        """Establece un nuevo nombre."""
        self.nombre = nombre

    def obtener_tasa_interes(self):
        return self.tasa_interes

    def establecer_tasa_interes(self, tasa):
        self.tasa_interes = tasa

    def calcular_interes(self, capital, tiempo):
        Calcula el interés generado.
        Fórmula: interés = capital * tasa * tiempo
        return capital * self.tasa_interes * tiempo

    def tiempo_para_duplicar(self):

        Calcula el tiempo necesario para duplicar el capital
        usando interés compuesto.
        Fórmula: t = ln(2) / ln(1 + tasa)

        if self.tasa_interes <= 0:
            return None
        return math.log(2) / math.log(1 + self.tasa_interes)


# Ejemplo de uso
if __name__ == "__main__":
    banco1 = Banco("Banco Ejemplo", 0.05)

    print(f"Banco: {banco1.obtener_nombre()}")
    print(f"Tasa de interés: {banco1.obtener_tasa_interes() * 100}%")

    # Calcular interés
    interes = banco1.calcular_interes(1000, 2)
    print(f"Interés generado en 2 años sobre $1000: ${interes:.2f}")

    # Tiempo para duplicar
    tiempo = banco1.tiempo_para_duplicar()
    print(f"Tiempo para duplicar el dinero: {tiempo:.2f} años")
