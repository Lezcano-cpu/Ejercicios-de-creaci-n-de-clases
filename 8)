class Tienda:
    def __init__(self, nombre):
        """Inicializa las propiedades de la tienda."""
        self.nombre = nombre          
        self.productos = []           

    def obtener_nombre(self):
        return self.nombre

    def establecer_nombre(self, nombre): 
        self.nombre = nombre

    def obtener_productos(self):
        return self.productos

    def agregar_producto(self, producto):
        self.productos.append(producto)

    def eliminar_producto(self, producto):
        """Elimina un producto de la lista."""
        if producto in self.productos:
            self.productos.remove(producto)
        else:
            print("El producto no está en la lista.")


# Ejemplo de uso
if __name__ == "__main__":
    tienda1 = Tienda("Mi Tienda")

    print(f"Tienda: {tienda1.obtener_nombre()}")

    # Agregar productos
    tienda1.agregar_producto("Laptop")
    tienda1.agregar_producto("Mouse")
    tienda1.agregar_producto("Teclado")

    print("Productos:", tienda1.obtener_productos())

    # Eliminar producto
    tienda1.eliminar_producto("Mouse")

    print("\nDespués de actualizar:")
    print("Productos:", tienda1.obtener_productos())
